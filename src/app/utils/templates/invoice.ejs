<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Invoice</title>
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Arial", sans-serif;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                min-height: 100vh;
                padding: 20px;
                color: #333;
            }

            .invoice-container {
                max-width: 800px;
                margin: 0 auto;
                background: white;
                border-radius: 15px;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
                overflow: hidden;
            }

            .invoice-header {
                background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
                color: white;
                padding: 40px;
                text-align: center;
                position: relative;
            }

            .invoice-header::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/></svg>')
                    center/100px;
                opacity: 0.3;
            }

            .invoice-title {
                font-size: 2.5rem;
                font-weight: bold;
                margin-bottom: 10px;
                text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
                position: relative;
                z-index: 1;
            }

            .invoice-subtitle {
                font-size: 1.1rem;
                opacity: 0.9;
                position: relative;
                z-index: 1;
            }

            .invoice-body {
                padding: 50px 40px;
            }

            .invoice-details {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 30px;
                margin-bottom: 40px;
            }

            .detail-card {
                background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
                color: white;
                padding: 25px;
                border-radius: 12px;
                box-shadow: 0 8px 25px rgba(240, 147, 251, 0.3);
                transform: translateY(0);
                transition: transform 0.3s ease;
            }

            .detail-card:hover {
                transform: translateY(-5px);
            }

            .detail-label {
                font-size: 0.9rem;
                opacity: 0.8;
                margin-bottom: 8px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .detail-value {
                font-size: 1.4rem;
                font-weight: bold;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2);
            }

            .thank-you-section {
                text-align: center;
                margin: 40px 0;
                padding: 30px;
                background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
                border-radius: 12px;
                border: 2px solid rgba(255, 255, 255, 0.3);
            }

            .thank-you-text {
                font-size: 1.3rem;
                color: #2c3e50;
                font-weight: 600;
                margin-bottom: 20px;
            }

            .download-section {
                text-align: center;
                margin-top: 30px;
            }

            .download-btn {
                display: inline-block;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                padding: 15px 30px;
                text-decoration: none;
                border-radius: 50px;
                font-weight: bold;
                font-size: 1.1rem;
                box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
                transition: all 0.3s ease;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .download-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 35px rgba(102, 126, 234, 0.6);
            }

            .invoice-footer {
                background: #2c3e50;
                color: white;
                text-align: center;
                padding: 20px;
                font-size: 0.9rem;
                opacity: 0.8;
            }

            .decorative-line {
                height: 4px;
                background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
                margin: 30px 0;
                border-radius: 2px;
            }

            @media (max-width: 768px) {
                .invoice-details {
                    grid-template-columns: 1fr;
                    gap: 20px;
                }

                .invoice-body {
                    padding: 30px 20px;
                }

                .invoice-header {
                    padding: 30px 20px;
                }

                .invoice-title {
                    font-size: 2rem;
                }
            }
        </style>
    </head>
    <body>
        <div class="invoice-container">
            <div class="invoice-header">
                <h1 class="invoice-title">Invoice for Booking</h1>
                <p class="invoice-subtitle">Tour Management System</p>
            </div>

            <div class="invoice-body">
                <!-- Customer and Date Information -->
                <div
                    class="customer-info"
                    style="
                        margin-bottom: 30px;
                        padding: 20px;
                        background: #f8f9fa;
                        border-radius: 10px;
                    "
                >
                    <div
                        style="
                            display: grid;
                            grid-template-columns: 1fr 1fr;
                            gap: 20px;
                        "
                    >
                        <div>
                            <div
                                style="
                                    font-size: 0.9rem;
                                    color: #666;
                                    margin-bottom: 5px;
                                "
                            >
                                CUSTOMER
                            </div>
                            <div
                                style="
                                    font-size: 1.2rem;
                                    font-weight: bold;
                                    color: #2c3e50;
                                "
                            >
                                <%= userName %>
                            </div>
                        </div>
                        <div>
                            <div
                                style="
                                    font-size: 0.9rem;
                                    color: #666;
                                    margin-bottom: 5px;
                                "
                            >
                                BOOKING DATE
                            </div>
                            <div
                                style="
                                    font-size: 1.2rem;
                                    font-weight: bold;
                                    color: #2c3e50;
                                "
                            >
                                <%= new
                                Date(bookingDate).toLocaleDateString('en-US', {
                                year: 'numeric', month: 'long', day: 'numeric'
                                }) %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Transaction and Tour Details -->
                <div class="invoice-details">
                    <div class="detail-card">
                        <div class="detail-label">Transaction ID</div>
                        <div class="detail-value"><%= transactionId %></div>
                    </div>

                    <div class="detail-card">
                        <div class="detail-label">Total Amount</div>
                        <div class="detail-value">
                            $<%= totalAmount.toFixed(2) %>
                        </div>
                    </div>
                </div>

                <!-- Tour Information Section -->
                <div
                    style="
                        margin: 30px 0;
                        padding: 25px;
                        background: linear-gradient(
                            135deg,
                            #a8edea 0%,
                            #fed6e3 100%
                        );
                        border-radius: 12px;
                    "
                >
                    <h3
                        style="
                            color: #2c3e50;
                            margin-bottom: 20px;
                            font-size: 1.4rem;
                        "
                    >
                        Tour Package Details
                    </h3>
                    <div
                        style="
                            display: grid;
                            grid-template-columns: 2fr 1fr;
                            gap: 20px;
                            align-items: start;
                        "
                    >
                        <div>
                            <div
                                style="
                                    font-size: 0.9rem;
                                    color: #666;
                                    margin-bottom: 5px;
                                    text-transform: uppercase;
                                    letter-spacing: 1px;
                                "
                            >
                                TOUR PACKAGE
                            </div>
                            <div
                                style="
                                    font-size: 1.3rem;
                                    font-weight: bold;
                                    color: #2c3e50;
                                    line-height: 1.4;
                                "
                            >
                                <%= tourTitle %>
                            </div>
                        </div>
                        <div>
                            <div
                                style="
                                    font-size: 0.9rem;
                                    color: #666;
                                    margin-bottom: 5px;
                                    text-transform: uppercase;
                                    letter-spacing: 1px;
                                "
                            >
                                GUESTS
                            </div>
                            <div
                                style="
                                    font-size: 2rem;
                                    font-weight: bold;
                                    color: #667eea;
                                    text-align: center;
                                "
                            >
                                <%= guestCount %>
                            </div>
                            <div
                                style="
                                    font-size: 0.8rem;
                                    color: #666;
                                    text-align: center;
                                "
                            >
                                Number of Guests
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Breakdown -->
                <div
                    style="
                        margin: 30px 0;
                        padding: 25px;
                        background: #f8f9fa;
                        border-radius: 12px;
                        border: 2px solid #e9ecef;
                    "
                >
                    <h3
                        style="
                            color: #2c3e50;
                            margin-bottom: 20px;
                            font-size: 1.2rem;
                        "
                    >
                        Payment Summary
                    </h3>
                    <div
                        style="
                            border-bottom: 1px solid #dee2e6;
                            padding-bottom: 15px;
                            margin-bottom: 15px;
                        "
                    >
                        <div
                            style="
                                display: flex;
                                justify-content: space-between;
                                margin-bottom: 8px;
                            "
                        >
                            <span style="color: #666">Subtotal:</span>
                            <span style="color: #2c3e50; font-weight: 500"
                                >$<%= totalAmount.toFixed(2) %></span
                            >
                        </div>
                        <div
                            style="
                                display: flex;
                                justify-content: space-between;
                                margin-bottom: 8px;
                            "
                        >
                            <span style="color: #666">Service Fee:</span>
                            <span style="color: #2c3e50; font-weight: 500"
                                >$0.00</span
                            >
                        </div>
                        <div
                            style="
                                display: flex;
                                justify-content: space-between;
                            "
                        >
                            <span style="color: #666">Taxes:</span>
                            <span style="color: #2c3e50; font-weight: 500"
                                >$0.00</span
                            >
                        </div>
                    </div>
                    <div
                        style="
                            display: flex;
                            justify-content: space-between;
                            font-size: 1.3rem;
                            font-weight: bold;
                            color: #667eea;
                        "
                    >
                        <span>Total Paid:</span>
                        <span>$<%= totalAmount.toFixed(2) %></span>
                    </div>
                </div>

                <div class="decorative-line"></div>

                <!-- Payment Status -->
                <div
                    style="
                        text-align: center;
                        margin: 30px 0;
                        padding: 20px;
                        background: linear-gradient(
                            135deg,
                            #d4edda 0%,
                            #c3e6cb 100%
                        );
                        border-radius: 12px;
                        border: 2px solid #28a745;
                    "
                >
                    <div
                        style="
                            font-size: 1.5rem;
                            color: #28a745;
                            font-weight: bold;
                            margin-bottom: 10px;
                        "
                    >
                        ✓ PAYMENT COMPLETED
                    </div>
                    <div style="color: #155724; font-size: 1rem">
                        Transaction processed successfully
                    </div>
                </div>

                <div class="thank-you-section">
                    <p class="thank-you-text">Thank you for your booking!</p>
                    <p style="color: #7f8c8d; font-size: 1rem">
                        We appreciate your trust in our tour management
                        services. Have an amazing travel experience!
                    </p>
                </div>

                <div class="download-section">
                    <a href="#" class="download-btn">Download Invoice PDF</a>
                </div>
            </div>

            <div class="invoice-footer">
                Generated on <%= new Date().toLocaleDateString() %> | Tour
                Management System
            </div>
        </div>
    </body>
</html>
