<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8" />
        <title>Forgot Password</title>
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: #333;
                line-height: 1.6;
                min-height: 100vh;
                padding: 20px;
            }

            .container {
                max-width: 650px;
                margin: 40px auto;
                background: #fff;
                border-radius: 20px;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
                overflow: hidden;
                position: relative;
            }

            .container::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 5px;
                background: linear-gradient(
                    90deg,
                    #667eea 0%,
                    #764ba2 50%,
                    #667eea 100%
                );
            }

            .header {
                background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
                color: white;
                padding: 40px 30px;
                text-align: center;
                position: relative;
            }

            .header::before {
                content: "🔑";
                font-size: 3rem;
                display: block;
                margin-bottom: 15px;
                filter: drop-shadow(2px 2px 4px rgba(0, 0, 0, 0.2));
            }

            .header h2 {
                font-size: 2rem;
                font-weight: 700;
                margin-bottom: 10px;
                text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
            }

            .header-subtitle {
                font-size: 1rem;
                opacity: 0.9;
                font-weight: 300;
            }

            .content {
                padding: 40px 30px;
            }

            .greeting {
                font-size: 1.2rem;
                color: #2c3e50;
                margin-bottom: 25px;
                font-weight: 600;
            }

            .message {
                font-size: 1rem;
                color: #495057;
                margin-bottom: 30px;
                line-height: 1.7;
                text-align: center;
                background: #f8f9fa;
                padding: 25px;
                border-radius: 12px;
                border-left: 4px solid #667eea;
            }

            .button-section {
                text-align: center;
                margin: 35px 0;
                padding: 30px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border-radius: 15px;
                box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
                position: relative;
                overflow: hidden;
            }

            .button-section::before {
                content: "";
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(
                    circle,
                    rgba(255, 255, 255, 0.1) 0%,
                    transparent 70%
                );
                animation: shimmer 4s ease-in-out infinite;
            }

            @keyframes shimmer {
                0%,
                100% {
                    transform: rotate(0deg);
                }
                50% {
                    transform: rotate(180deg);
                }
            }

            .btn-label {
                color: rgba(255, 255, 255, 0.9);
                font-size: 0.9rem;
                margin-bottom: 15px;
                text-transform: uppercase;
                letter-spacing: 1px;
                font-weight: 500;
                position: relative;
                z-index: 1;
            }

            .btn {
                display: inline-block;
                padding: 18px 35px;
                background: rgba(255, 255, 255, 0.2);
                color: #ffffff;
                text-decoration: none;
                border-radius: 50px;
                font-weight: bold;
                font-size: 1.1rem;
                backdrop-filter: blur(10px);
                border: 2px solid rgba(255, 255, 255, 0.3);
                transition: all 0.3s ease;
                text-transform: uppercase;
                letter-spacing: 1px;
                position: relative;
                z-index: 1;
            }

            .btn:hover {
                background: rgba(255, 255, 255, 0.3);
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(255, 255, 255, 0.3);
            }

            .warning-section {
                background: linear-gradient(135deg, #ffeaa7 0%, #fab1a0 100%);
                color: #2d3436;
                padding: 25px;
                border-radius: 12px;
                margin: 25px 0;
                font-weight: 500;
                box-shadow: 0 5px 15px rgba(255, 234, 167, 0.4);
                position: relative;
            }

            .warning-section::before {
                content: "⚠️";
                font-size: 1.5rem;
                margin-right: 10px;
            }

            .expiry-info {
                background: #e3f2fd;
                border-left: 4px solid #2196f3;
                padding: 20px;
                margin: 25px 0;
                border-radius: 0 8px 8px 0;
                font-size: 0.95rem;
                color: #0d47a1;
            }

            .expiry-info::before {
                content: "⏱️ ";
                font-size: 1.2rem;
            }

            .security-tips {
                background: #f1f8e9;
                border-left: 4px solid #4caf50;
                padding: 20px;
                margin: 25px 0;
                border-radius: 0 8px 8px 0;
                font-size: 0.9rem;
                color: #2e7d32;
            }

            .security-tips::before {
                content: "🛡️ ";
                font-size: 1.2rem;
            }

            .footer {
                background: #2c3e50;
                color: rgba(255, 255, 255, 0.8);
                text-align: center;
                padding: 25px 30px;
                font-size: 0.9rem;
                position: relative;
            }

            .footer::before {
                content: "";
                position: absolute;
                top: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 100px;
                height: 3px;
                background: linear-gradient(90deg, #ff6b6b 0%, #ee5a52 100%);
                border-radius: 0 0 3px 3px;
            }

            .company-name {
                font-weight: 700;
                color: #fff;
                margin-bottom: 5px;
            }

            @media (max-width: 600px) {
                .container {
                    margin: 20px auto;
                    border-radius: 15px;
                }

                .content {
                    padding: 30px 20px;
                }

                .header {
                    padding: 30px 20px;
                }

                .btn {
                    font-size: 1rem;
                    padding: 15px 25px;
                }

                .header h2 {
                    font-size: 1.5rem;
                }

                .button-section {
                    padding: 25px 15px;
                }
            }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">
                <h2>Password Reset Request</h2>
                <div class="header-subtitle">Secure Account Recovery</div>
            </div>

            <div class="content">
                <p class="greeting">Hello <%= name %>,</p>

                <div class="message">
                    We received a request to reset your password for your
                    account. Click the button below to set a new password:
                </div>

                <div class="button-section">
                    <div class="btn-label">Secure Password Reset</div>
                    <a class="btn" href="<%= resetUILink %>">Reset Password</a>
                </div>

                <div class="warning-section">
                    <strong>Important:</strong> If you did not request a
                    password reset, please ignore this email.
                </div>

                <div class="expiry-info">
                    <strong>Time Sensitive:</strong> This link will expire in 10
                    minutes for your security.
                </div>

                <div class="security-tips">
                    <strong>Security Tip:</strong> Always ensure you're on the
                    official Tour Management website when entering your new
                    password.
                </div>
            </div>

            <div class="footer">
                <div class="company-name">Tour Management System</div>
                <div>&copy; 2025 All rights reserved.</div>
            </div>
        </div>
    </body>
</html>
